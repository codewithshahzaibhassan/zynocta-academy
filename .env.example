# Copy this file to .env and set your own values.
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Local mode works without Supabase and stores records in ./data/db.json and PDFs in ./uploads.
# Set STORAGE_MODE=supabase only after completing the Supabase setup in README.md.
STORAGE_MODE=local

# Initial administrator account (created on first startup if no admin exists).
ADMIN_NAME=Academy Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThis-Strong-Password-123!

# Required only for STORAGE_MODE=supabase. Keep the service-role key on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=academy-pdfs

# Required for persistent PostgreSQL-backed sessions in production. In local development
# Express uses its built-in MemoryStore; never use that default for a public production deployment.
DATABASE_URL=
